# Public browser configuration only. Never put Alpaca, Groq, database, or JWT secrets here.
# These values are inlined at `next build` time.

# Backend origin (no trailing slash). Required for production builds.
# Local development default in code is http://127.0.0.1:8001 when this is unset.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# Public frontend origin (QR codes). Required in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: force demo-mode UI flag
# NEXT_PUBLIC_DEMO_MODE=false
