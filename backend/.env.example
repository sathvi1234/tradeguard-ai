# Copy to backend/.env for local development. Never commit the real .env.

# --- Required safety (must remain true in production) ---
ALPACA_PAPER_TRADE=true
DRY_RUN=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Alpaca paper keys (server-side only). Never put these in the frontend.
ALPACA_API_KEY=<your-paper-api-key>
ALPACA_SECRET_KEY=<your-paper-secret-key>

# Groq LLM (server-side only). LLM_API_KEY and GROQ_API_KEY are aliases.
LLM_PROVIDER=groq
LLM_API_KEY=<your-groq-api-key>
LLM_MODEL=llama-3.1-8b-instant

# Public demo identity (not a secret)
DEMO_USER_EMAIL=demo@tradeai.local

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# CORS: production frontend origin. Localhost origins are added automatically
# unless ENVIRONMENT=production.
FRONTEND_URL=http://localhost:3000
# Optional extra origins (CSV or JSON). Do not use "*".
# CORS_ORIGINS=https://your-frontend.example

# Database: PostgreSQL when set. If omitted, SQLite at backend/data/demo_ledger.sqlite
# Managed providers often give postgres://... — the app rewrites that to postgresql+psycopg://
# Example only — do not commit real credentials.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tradeguard

# Optional process bind. Local `python -m app.main` stays 127.0.0.1:8001 unless PORT is set.
# PORT=8001
